<Bindings>
    <!-- Options > Keybindings > Goldsmith: its own section, named by the
         category (user, 2026-10-16). The game loads this file itself. -->
    <Binding name="GOLDSMITH_TOGGLE" category="Goldsmith">
        Goldsmith:ToggleWindow()
    </Binding>
    <Binding name="GOLDSMITH_CRAFT_NEXT" category="Goldsmith">
        Goldsmith:CraftNext()
    </Binding>
    <Binding name="GOLDSMITH_BUY_NEXT" category="Goldsmith">
        Goldsmith:BuyNext()
    </Binding>
    <Binding name="GOLDSMITH_OPEN_ITEM" category="Goldsmith">
        Goldsmith:OpenHoveredItem()
    </Binding>
    <!-- Held: runs on press and on release (keystate "down" / "up") -->
    <Binding name="GOLDSMITH_PEEK" category="Goldsmith" runOnUp="true">
        Goldsmith:PeekBinding(keystate == "down")
    </Binding>
</Bindings>
